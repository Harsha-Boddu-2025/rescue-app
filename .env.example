# ========================================
# 🐾 Pet Rescue Operations - Configuration
# ========================================
# Copy this file to .env and fill in your values

# ========== Google Gemini API ==========
# Get your API key from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here

# ========== Flask Backend ==========
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=8000
FLASK_HOST=0.0.0.0

# ========== Streamlit Frontend ==========
STREAMLIT_PORT=8501
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost

# ========== API Configuration ==========
# Backend API URL
API_URL=http://localhost:8000
API_TIMEOUT=30

# ========== File Upload ==========
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE_MB=16
ALLOWED_FORMATS=jpg,jpeg,png

# ========== Database (Optional) ==========
# Leave empty to use in-memory storage (demo mode)
# For production, use PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/rescue_db
DATABASE_ECHO=False

# ========== SMS Notifications (Optional) ==========
# Twilio configuration for sending SMS notifications
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ========== Email Notifications (Optional) ==========
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_FILE=rescue_app.log

# ========== Security ==========
# For production, generate a strong secret key
SECRET_KEY=your-secret-key-here-change-in-production
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# ========== Google Maps (Optional) ==========
# For map integration
GOOGLE_MAPS_API_KEY=your-api-key-here

# ========== Development ==========
DEBUG=True
TESTING=False

# ========== Application Version ==========
APP_VERSION=1.0.0
APP_ENV=development
